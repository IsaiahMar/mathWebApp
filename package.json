{
  "name": "quickfire",
  "version": "1.0.0",
  "private": true,
  "description": "A timed mental-arithmetic game with order-of-operations practice.",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 3000 .",
    "test": "node --test tests/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
